generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum PersonType {
  NATURAL
  JURIDICA
}

enum MovementType {
  ENTRY
  EXIT
  ADJUSTMENT
}

enum OrderStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
}

enum InvoiceStatus {
  ACTIVE
  ANNULLED
}

enum PurchaseOrderStatus {
  PENDING
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum UserRole {
  ADMIN
  SELLER
  INVENTORY_MANAGER
  DISPATCH_MANAGER
  OWNER_MANAGER
}

model LoginAttempt {
  id        String   @id @default(cuid()) @map("id")
  ip        String   @map("ip")
  userId    String?  @map("user_id")
  success   Boolean  @default(false) @map("success")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([ip])
  @@index([createdAt])
  @@map("login_attempts")
}

model UserAuditLog {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  actorId   String   @map("actor_id")
  action    String   @map("action")
  details   Json?    @map("details")
  createdAt DateTime @default(now()) @map("created_at")

  user   User @relation("AuditLogUser", fields: [userId], references: [id])
  actor  User @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([userId])
  @@index([actorId])
  @@index([createdAt])
  @@map("user_audit_logs")
}

model User {
  id        String     @id @default(cuid()) @map("id")
  fullName  String     @map("full_name")
  email     String     @unique @map("email")
  password  String     @map("password")
  status    UserStatus @default(ACTIVE) @map("status")
  role      UserRole   @map("role")
  failedAttempts Int      @default(0) @map("failed_attempts")
  lockoutUntil   DateTime? @map("lockout_until")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  sales              Sale[]
  inventoryMovements InventoryMovement[]
  auditLogs          UserAuditLog[]      @relation("AuditLogUser")
  performedActions   UserAuditLog[]      @relation("AuditLogActor")
  priceChanges       PriceHistory[]
  purchaseOrders     PurchaseOrder[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Category {
  id          String   @id @default(cuid()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  status      Boolean  @default(true) @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([status])
  @@map("categories")
}

model Brand {
  id          String   @id @default(cuid()) @map("id")
  name        String   @unique @map("name")
  status      Boolean  @default(true) @map("status")
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([name])
  @@index([status])
  @@map("brands")
}

model Supplier {
  id                   String   @id @default(cuid()) @map("id")
  name                 String   @unique @map("name")
  taxId                String   @unique @map("tax_id")
  contactName          String?  @map("contact_name")
  phone                String?  @map("phone")
  email                String?  @map("email")
  address              String?  @map("address")
  commercialConditions String?  @map("commercial_conditions")
  status               Boolean  @default(true) @map("status")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  purchaseOrders       PurchaseOrder[]

  @@index([name])
  @@index([taxId])
  @@index([status])
  @@map("suppliers")
}

model Product {
  id             String   @id @default(cuid()) @map("id")
  code           String   @unique @map("code")
  name           String   @map("name")
  description    String?  @map("description")
  cost           Decimal  @db.Decimal(12, 2) @map("cost")
  price          Decimal  @db.Decimal(12, 2) @map("price")
  status         Boolean  @default(true) @map("status")
  categoryId     String   @map("category_id")
  brandId        String?  @map("brand_id")
  unitOfMeasure  String?  @map("unit_of_measure")
  minimumStock   Int      @default(0) @map("minimum_stock")
  supplier       String?  @map("supplier")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category           Category           @relation(fields: [categoryId], references: [id])
  brand              Brand?             @relation(fields: [brandId], references: [id])
  images             ProductImage[]
  inventory          Inventory[]
  inventoryMovements InventoryMovement[]
  saleItems          SaleItem[]
  priceHistory       PriceHistory[]
  purchaseOrderItems PurchaseOrderItem[]

  @@index([code])
  @@index([categoryId])
  @@index([brandId])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id         String   @id @default(cuid()) @map("id")
  productId  String   @map("product_id")
  url        String   @map("url")
  fileKey    String?  @map("file_key")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id         String   @id @default(cuid()) @map("id")
  productId  String   @map("product_id")
  quantity   Int      @default(0) @map("quantity")
  location   String   @map("location")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, location])
  @@index([productId])
  @@map("inventory")
}

model InventoryMovement {
  id               String        @id @default(cuid()) @map("id")
  productId        String        @map("product_id")
  type             MovementType  @map("type")
  quantity         Int           @map("quantity")
  previousQuantity Int?          @map("previous_quantity")
  newQuantity      Int?          @map("new_quantity")
  reason           String?       @map("reason")
  userId           String        @map("user_id")
  createdAt        DateTime      @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([userId])
  @@map("inventory_movements")
}

model Customer {
  id         String     @id @default(cuid()) @map("id")
  personType PersonType @map("person_type")
  fullName   String     @map("full_name")
  taxId      String     @unique @map("tax_id")
  address    String?    @map("address")
  phone      String?    @map("phone")
  email      String?    @map("email")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  sales  Sale[]
  orders Order[]

  @@index([fullName])
  @@index([isActive])
  @@map("customers")
}

model Sale {
  id        String   @id @default(cuid()) @map("id")
  total     Decimal  @db.Decimal(12, 2) @map("total")
  customerId  String   @map("client_id")
  sellerId    String   @map("seller_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  customer  Customer   @relation(fields: [customerId], references: [id])
  seller    User       @relation(fields: [sellerId], references: [id])
  items   SaleItem[]
  invoice Invoice?

  @@index([customerId])
  @@index([sellerId])
  @@index([createdAt])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid()) @map("id")
  saleId      String   @map("sale_id")
  productId   String   @map("product_id")
  quantity    Int      @map("quantity")
  unitPrice   Decimal  @db.Decimal(12, 2) @map("unit_price")
  subtotal    Decimal  @db.Decimal(12, 2) @map("subtotal")

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model Invoice {
  id               String        @id @default(cuid()) @map("id")
  number           String        @unique @map("number")
  saleId           String        @unique @map("sale_id")
  status           InvoiceStatus @default(ACTIVE) @map("status")
  annulmentReason  String?       @map("annulment_reason")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([number])
  @@index([status])
  @@map("invoices")
}

model Order {
  id        String      @id @default(cuid()) @map("id")
  customerId    String      @map("client_id")
  total         Decimal     @db.Decimal(12, 2) @map("total")
  status        OrderStatus @default(PENDING) @map("status")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  customer      Customer     @relation(fields: [customerId], references: [id])
  dispatchOrders DispatchOrder[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model DispatchOrder {
  id            String    @id @default(cuid()) @map("id")
  orderId       String    @map("order_id")
  destination   String    @map("destination")
  packages      Int       @map("packages")
  carrier       String?   @map("carrier")
  departureDate DateTime? @map("departure_date")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("dispatch_orders")
}

model PriceHistory {
  id                String   @id @default(cuid()) @map("id")
  productId         String   @map("product_id")
  previousCost      Decimal  @db.Decimal(12, 2) @map("previous_cost")
  newCost           Decimal  @db.Decimal(12, 2) @map("new_cost")
  previousSalePrice Decimal  @db.Decimal(12, 2) @map("previous_sale_price")
  newSalePrice      Decimal  @db.Decimal(12, 2) @map("new_sale_price")
  justification     String?  @map("justification")
  changedBy         String   @map("changed_by")
  createdAt         DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [changedBy], references: [id])

  @@index([productId])
  @@index([changedBy])
  @@index([createdAt])
  @@map("price_history")
}

model PurchaseOrder {
  id                   String              @id @default(cuid()) @map("id")
  supplierId           String              @map("supplier_id")
  referenceNumber      String              @unique @map("reference_number")
  estimatedReceiptDate DateTime?           @map("estimated_receipt_date")
  paymentTerms         String?             @map("payment_terms")
  notes                String?             @map("notes")
  status               PurchaseOrderStatus @default(PENDING) @map("status")
  totalEstimated       Decimal             @db.Decimal(12, 2) @map("total_estimated")
  createdBy            String              @map("created_by")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  items    PurchaseOrderItem[]
  creator  User                @relation(fields: [createdBy], references: [id])

  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
  @@index([createdBy])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String   @id @default(cuid()) @map("id")
  purchaseOrderId String   @map("purchase_order_id")
  productId       String   @map("product_id")
  quantityOrdered Int      @map("quantity_ordered")
  unitCost        Decimal  @db.Decimal(12, 2) @map("unit_cost")
  subtotal        Decimal  @db.Decimal(12, 2) @map("subtotal")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}
